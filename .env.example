# Biến môi trường cho stack (nhập trong Portainer → Environment variables). KHÔNG commit file .env thật.

# Mật khẩu tài khoản sa của SQL Server: tối thiểu 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt
MSSQL_SA_PASSWORD=DoiMatKhau@Manh2026
# Bản SQL Server: Express (miễn phí, giới hạn 10GB/database) hoặc Developer (chỉ dùng thử nghiệm)
MSSQL_PID=Express
DB_NAME=SquishyPop
# Cổng SQL Server trên server. 127.0.0.1 = chỉ kết nối qua đường hầm SSH (an toàn); 0.0.0.0 = mở ra Internet
MSSQL_BIND_IP=127.0.0.1
MSSQL_PUBLIC_PORT=1433

# Khóa ký token đăng nhập: chuỗi ngẫu nhiên dài từ 64 ký tự (đổi khóa = mọi người phải đăng nhập lại)
JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai-it-nhat-64-ky-tu-.........................

# Gmail gửi mail quên mật khẩu (dùng App Password của Google)
SMTP_USERNAME=
SMTP_PASSWORD=

# Cổng web trên server
WEB_PORT=8080

# Repo frontend (thêm token nếu repo private)
FE_GIT_CONTEXT=https://github.com/Trung2552003/Squishy-FE.git#main

# Tên miền riêng của trang đặt trước (nếu có), VD https://order.squishypop.vn
EXTRA_CORS_ORIGIN=
